//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors/naginata.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define NAGINATA 1
#define MOUSE    2
#define LOWER    3
#define RAISE    4
#define ADJUST   5
#define MOD      6
#define SCROLL   3

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                        &zip_temp_layer MOUSE 50
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS
        // 他キーとの同時押しのみHold(Shift), 500m以上長押しすると、Tap(Space)のリピート

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>; // tap-unless-interruptedのため意味は無いが、設定しないとエラーはく
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        ht_BASE: ht_BASE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&BL_mod>, <&kp>;

            display-name = "ht-BL_mod";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer)

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Support swapping into Scroll layer when AML is activated

        to_scroll_layer: to_scroll_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to SCROLL>,
                <&macro_press>,
                <&mo SCROLL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SCROLL>;
        };

        BL_mod: BL_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo MOD &macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&mo MOD>;
        };

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LANG1 &to NAGINATA>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LANG2 &to BASE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <44 45>;
            bindings = <&ng_on>;
            layers = <0 1>;
        };

        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <36 37>;
            bindings = <&ng_off>;
            layers = <0 1>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC        &kp N1      &kp N2  &kp N3        &kp N4                 &kp N5                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE              &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0           &kp LEFT_BRACE
&kp TAB        &kp Q       &kp W   &kp E         &kp R                  &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY            &kp Y         &kp U   &kp I      &kp O    &kp P            &kp MINUS
&kp BACKSPACE  &kp A       &kp S   &kp D         &kp F                  &kp G      &kp Y               &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp F1  &kp H         &kp J   &kp K      &kp L    &lt 2 SEMICOLON  &kp SQT
&kp LSHFT      &kp Z       &kp X   &kp C         &kp V                  &kp B      &kp LEFT_SHIFT      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp B   &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH         &lt SCROLL BACKSLASH
&mo 4          &kp C_MUTE          &kp LEFT_ALT  &lt 2 INTERNATIONAL_5  &kp SPACE  &kp LEFT_CONTROL                                                            &mo 3   &kp RETURN                                                 &td1
            >;
        };

        naginata_layer {
            display-name = "Naginata";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans  &trans  &trans  &trans        &trans         &trans                  &trans  &trans  &trans  &trans            &trans  &trans  &trans     &trans   &trans     &trans
&trans  &ng Q   &ng W   &ng E         &ng R          &ng T                   &trans  &trans  &trans  &trans            &ng Y   &ng U   &ng I      &ng O    &ng P      &kp EQUAL
&trans  &ng A   &ng S   &ng D         &ng F          &ng G      &kp INS      &trans  &trans  &trans  &trans    &trans  &ng H   &ng J   &ng K      &ng L    &ng SEMI   &kp SQT
&trans  &ng Z   &ng X   &ng C         &ng V          &ng B      &kp GRAVE    &trans  &trans  &trans  &trans    &trans  &ng N   &ng M   &ng COMMA  &ng DOT  &ng SLASH  &trans
&trans  &trans          &BL_mod LWIN  &BL_mod LCTRL  &ng SPACE  &trans                                         &trans  &trans                                         &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp LS(DELETE)  &none   &none    &none          &kp LG(LC(LEFT_ARROW))  &kp LC(LG(RIGHT_ARROW))            &trans  &trans  &trans  &trans           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_NXT  &bt BT_CLR
&none           &none   &kp F24  &to_layer_0 E  &none                   &none                              &trans  &trans  &trans  &trans           &none         &none         &none         &none         &none       &none
&kp BACKSPACE   &none   &mo 3    &mkp RCLK      &mkp LCLK               &none                    &none     &trans  &trans  &trans  &trans    &none  &none         &mkp LCLK     &mkp RCLK     &mo 3         &to 0       &mo 2
&none           &none   &none    &none          &none                   &none                    &trans    &trans  &trans  &trans  &trans    &none  &none         &none         &none         &none         &mkp MB4    &mkp MB5
&none           &trans           &trans         &trans                  &trans                   &trans                                      &none  &kp LC(I)                                                           &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans         &none      &none   &none   &none   &none               &trans  &trans  &trans  &trans                       &none      &none         &none         &none         &kp KP_SLASH  &none
&trans         &none      &none   &none   &none   &none               &trans  &trans  &trans  &trans                       &kp COMMA  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &none
&kp BACKSPACE  &kp F1     &kp F2  &kp F3  &kp F4  &kp F5   &kp F11    &trans  &trans  &trans  &trans    &kp LS(SEMICOLON)  &kp MINUS  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp NUMBER_0  &kp MINUS
&trans         &kp F6     &kp F7  &kp F8  &kp F9  &kp F10  &kp F12    &trans  &trans  &trans  &trans    &kp LS(SQT)        &kp SLASH  &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp LS(N5)    &none
&trans         &kp RSHFT          &trans  &trans  &trans   &trans                                       &none              &none                                                              &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LA(F2) LA(F1)>;
            bindings = <
&trans  &none  &none  &none   &none   &none             &trans  &trans  &trans  &trans               &none     &none     &kp LC(HOME)  &none      &none    &none
&trans  &none  &none  &none   &none   &none             &trans  &trans  &trans  &trans               &none     &none     &kp UP_ARROW  &none      &none    &none
&trans  &none  &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &kp LEFT  &kp DOWN      &kp RIGHT  &kp END  &none
&trans  &none  &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp PG_DN  &none     &none     &kp LC(END)   &none      &none    &none
&trans  &none         &trans  &trans  &trans  &trans                                      &trans     &kp DEL                                               &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        mod_layer {
            display-name = "Mod";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC    &kp N1      &kp N2  &kp N3  &kp N4  &kp N5                     &trans  &trans  &trans  &trans                 &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q       &kp W   &kp E   &kp R   &kp T                      &trans  &trans  &trans  &trans                 &kp Y   &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&kp CAPS   &kp A       &kp S   &kp D   &kp F   &kp G            &trans    &trans  &trans  &trans  &kp INS      &kp LBKT  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X   &kp C   &kp V   &kp B            &trans    &trans  &trans  &trans  &kp GRAVE    &kp RBKT  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &lt SCROLL BACKSLASH
&trans     &kp C_MUTE          &trans  &trans  &mt LSHFT SPACE  &trans                                         &trans    &trans                                        &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
